@Transactional
public List<Order> checkout(CheckoutRequest request) {

    if (request.items() == null || request.items().isEmpty()) {
        throw new IllegalArgumentException("Checkout must have at least one item");
    }

    Customer customer = customerRepository.findByIdAndActiveTrue(request.customerId())
            .orElseThrow(() -> new EntityNotFoundException("Customer not found"));

    // 1️⃣ Load all products at once
    List<Long> productIds = request.items().stream()
            .map(CheckoutItemRequest::productId)
            .toList();

    List<Product> products = productRepository.findAllById(productIds);

    Map<Long, Product> productMap = products.stream()
            .collect(Collectors.toMap(Product::getId, p -> p));

    // 2️⃣ Group items by store
    Map<Store, List<CheckoutItemRequest>> itemsByStore = new HashMap<>();

    for (CheckoutItemRequest item : request.items()) {
        Product product = productMap.get(item.productId());

        if (product == null) {
            throw new EntityNotFoundException("Product not found: " + item.productId());
        }

        Store store = product.getStore();

        itemsByStore
                .computeIfAbsent(store, k -> new ArrayList<>())
                .add(item);
    }

    List<Order> createdOrders = new ArrayList<>();

    // 3️⃣ Create one order per store
    for (Map.Entry<Store, List<CheckoutItemRequest>> entry : itemsByStore.entrySet()) {

        Store store = entry.getKey();
        List<CheckoutItemRequest> storeItems = entry.getValue();

        Order order = new Order();
        order.setCustomer(customer);
        order.setStore(store);
        order.setStatus("PENDING");
        order.setDate(LocalDateTime.now());

        BigDecimal total = BigDecimal.ZERO;

        List<OrderItem> orderItems = new ArrayList<>();

        // 4️⃣ Create order items
        for (CheckoutItemRequest item : storeItems) {

            Product product = productMap.get(item.productId());

            // 🔥 (Optional but recommended)
            Inventory inventory = inventoryRepository
                    .findByStoreIdAndProductId(store.getId(), product.getId())
                    .orElseThrow(() -> new RuntimeException("Inventory not found"));

            if (inventory.getQuantity() < item.quantity()) {
                throw new RuntimeException("Not enough stock for product " + product.getId());
            }

            // decrease stock
            inventory.setQuantity(inventory.getQuantity() - item.quantity());

            BigDecimal price = product.getPrice();
            BigDecimal itemTotal = price.multiply(BigDecimal.valueOf(item.quantity()));

            OrderItem orderItem = new OrderItem();
            orderItem.setOrder(order);
            orderItem.setProduct(product);
            orderItem.setQuantity(item.quantity());
            orderItem.setSalePrice(price);

            total = total.add(itemTotal);

            orderItems.add(orderItem);
        }

        order.setTotalAmount(total);
        order.setItems(orderItems); // cascade should persist items

        createdOrders.add(order);
    }

    // 5️⃣ Save all orders (cascade saves items)
    return orderRepository.saveAll(createdOrders);
}